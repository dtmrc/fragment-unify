# Required to run the agentic Claude pipeline (schema inference, field mapping,
# entity reconciliation) and the natural-language query layer.
# Get a key at https://console.anthropic.com/ — the app runs without it, but the
# pipeline and NL-query endpoints return a clear "set ANTHROPIC_API_KEY" error.
ANTHROPIC_API_KEY=

# Optional. Port the HTTP server binds to (default 3000).
PORT=3000
